*.sh text eol=lf

# Beads: the hook shims are POSIX sh, and issues.jsonl is compared byte-for-byte
# against `bd export` output (LF), so neither may be CRLF-converted on checkout.
.beads/hooks/* text eol=lf
.beads/*.sh text eol=lf
.beads/issues.jsonl -text

# Binary sound fixtures: no line-ending conversion, and not treated as text.
tests/fixtures/** -text
